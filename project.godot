; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

ss2d/version="3.3.1"

[application]

config/name="You. Must. Sleep "
config/description="our cool game jam
made by dean and chiel and erin"
config/version="- pre alpha not fucking done yet stage of gamedevelopment"
run/main_scene="uid://4atoxgqigr8l"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://dynhqydehk1ve"

[audio]

buses/default_bus_layout="uid://b281q64oi4hyt"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
AppConfig="*uid://cjke6crjg14a0"
SceneLoader="*uid://cbwmrnp0af35y"
ProjectMusicController="*uid://r5t485lr3p7t"
ProjectUISoundController="*uid://cc37235kj4384"
DebugMenu="*uid://cggqb75a8w8r"
DialogueManager="*uid://c3rodes2l3gxb"
GUIDE="*uid://p2jwrgjcbexr"
InputManager="*uid://cphxwf4b0om4v"
LightManager="*uid://lnayhbjd18wf"

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0,
"res://assets/scenes/credits": 0,
"res://assets/scenes/game/scripts": 0,
"res://assets/scenes/ui": 0,
"res://examples": 0
}
gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=1
gdscript/warnings/missing_await=1

[dialogue_manager]

runtime/balloon_path="res://assets/dialogue/balloon.tscn"

[display]

window/size/viewport_width=854
window/size/viewport_height=480
window/size/borderless=true
window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/debug_menu/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/godotresourcecleaner/plugin.cfg", "res://addons/guide/plugin.cfg", "res://addons/health_hitbox_hurtbox/plugin.cfg", "res://addons/maaacks_game_template/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg", "res://addons/rmsmartshape/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://examples/": "gray"
}

[gui]

theme/custom="uid://bac1khm2nmjl3"
theme/custom_font="uid://coisyh8l6rcuc"

[importer_defaults]

2d_array_texture={
&"compress/channel_pack": 1,
&"mipmaps/generate": false
}
texture={
&"detect_3d/compress_to": 0
}

